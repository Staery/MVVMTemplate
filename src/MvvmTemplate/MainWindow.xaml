<Window x:Class="MvvmTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nav="clr-namespace:MvvmTemplate.Core.Navigation;assembly=MvvmTemplate.Core"
        xmlns:vm="clr-namespace:MvvmTemplate.Core.ViewModels;assembly=MvvmTemplate.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding AppName}"
        Width="1100"
        Height="720"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.InputBindings>
    <KeyBinding Command="{Binding GoBackCommand}" Gesture="Alt+Left" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================== Sidebar ============================== -->
    <Border Background="{StaticResource SidebarBrush}">
      <DockPanel Margin="14,20,14,16">

        <!-- Brand -->
        <StackPanel Margin="6,0,0,28" DockPanel.Dock="Top" Orientation="Horizontal">
          <Border Width="38" Height="38" Background="{StaticResource AccentGradientBrush}" CornerRadius="10">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="M" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="{Binding AppName}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="WPF · MVVM" />
          </StackPanel>
        </StackPanel>

        <TextBlock Margin="10,0,0,0"
                   DockPanel.Dock="Bottom"
                   FontSize="11"
                   Foreground="{StaticResource SidebarMutedBrush}"
                   Text="Alt+← to go back" />

        <!-- Menu: selecting an entry navigates to its page view model -->
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource SidebarHeader}" Text="NAVIGATION" />
          <ListBox ItemContainerStyle="{StaticResource NavItem}"
                   ItemsSource="{Binding MenuItems}"
                   SelectedItem="{Binding SelectedMenuItem}"
                   Style="{StaticResource NavList}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type nav:NavigationItem}">
                <StackPanel Orientation="Horizontal">
                  <Path Margin="0,0,12,0"
                        Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}"
                        Style="{StaticResource Icon}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- ============================== Content ============================== -->
    <DockPanel Grid.Column="1">

      <!-- Header with back button and page title -->
      <Border Padding="20,14"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,0,0,1"
              DockPanel.Dock="Top">
        <StackPanel Orientation="Horizontal">
          <Button Margin="0,0,10,0"
                  Command="{Binding GoBackCommand}"
                  Style="{StaticResource IconButton}"
                  ToolTip="Back (Alt+Left)">
            <Path Data="{StaticResource Icon.Back}" Style="{StaticResource Icon}" />
          </Button>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="{Binding CurrentPage.Title}" />
        </StackPanel>
      </Border>

      <!-- The current page. WPF finds its view through the DataTemplates in Views/ViewTemplates.xaml. -->
      <ContentControl Content="{Binding CurrentPage}" Focusable="False" />

    </DockPanel>
  </Grid>
</Window>
